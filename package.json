{
  "name": "sftp-mcp",
  "version": "1.1.3",
  "mcpName": "io.github.AdversTM/sftp-mcp",
  "description": "SFTP-only MCP server: let AI assistants browse, edit, transfer and sync files without shell access. Works with chrooted accounts; per-server read-only, non-destructive and path policies.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sftp",
    "sftp-client",
    "file-transfer",
    "chroot",
    "ai",
    "llm",
    "claude",
    "deployment"
  ],
  "author": "Damian Szuster",
  "license": "MIT",
  "homepage": "https://github.com/AdversTM/sftp-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdversTM/sftp-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AdversTM/sftp-mcp/issues"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sftp-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
